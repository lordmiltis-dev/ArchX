tests/fader_test.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/fader_test.dir/build.make CMakeFiles/fader_test.dir/tests/fader_test.cpp.s
.PHONY : tests/fader_test.cpp.s

tests/main.o: tests/main.cpp.o
.PHONY : tests/main.o

# target to build an object file
tests/main.cpp.o:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/archx_hello.dir/build.make CMakeFiles/archx_hello.dir/tests/main.cpp.o
.PHONY : tests/main.cpp.o

tests/main.i: tests/main.cpp.i
.PHONY : tests/main.i

# target to preprocess a source file
tests/main.cpp.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/archx_hello.dir/build.make CMakeFiles/archx_hello.dir/tests/main.cpp.i
.PHONY : tests/main.cpp.i

tests/main.s: tests/main.cpp.s
.PHONY : tests/main.s

# target to generate assembly for a file
tests/main.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/archx_hello.dir/build.make CMakeFiles/archx_hello.dir/tests/main.cpp.s
.PHONY : tests/main.cpp.s

